# =============================================================================
# SSG Products — environment variables
# -----------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is gitignored; never commit real
# values. On Vercel, set the same variables under Project → Settings →
# Environment Variables.
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle and is
# PUBLIC. Never put a secret behind that prefix.
# =============================================================================

# --- Site --------------------------------------------------------------------
# Canonical origin. Used for metadata, Open Graph, sitemap and email links.
# Must be the real https:// domain in production or emailed links will 404.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Supabase ----------------------------------------------------------------
# From Supabase → Project Settings → API.
#
# Supabase renamed these keys. Newer projects show "publishable" and "secret";
# older ones show "anon" and "service_role". The app accepts either name.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (formerly "anon") key. Public by design — it ships to the browser.
# It is safe to expose ONLY because Row Level Security is enabled on every
# table. See supabase/migrations/0002_rls.sql.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret (formerly "service_role") key. BYPASSES ROW LEVEL SECURITY COMPLETELY.
# Server-side only. If this ever reaches the browser, every customer's name,
# phone, address and order history is readable by anyone. It must never be
# given a NEXT_PUBLIC_ prefix and never be pasted into client-side code.
SUPABASE_SECRET_KEY=


# --- Email (Resend) ----------------------------------------------------------
# Optional. Without these the store still takes orders, but confirmation and
# shipping emails are not sent — and the admin is told so explicitly rather
# than being shown a false success. Nothing is faked.
#
# ORDER_EMAIL_FROM must be on a domain verified in Resend, otherwise sends are
# rejected. Format: "SSG Products <orders@yourdomain.com>"

RESEND_API_KEY=
ORDER_EMAIL_FROM=
# Optional: copy every customer email to the store owner's inbox.
ORDER_EMAIL_BCC=


# --- Payments (Razorpay) -----------------------------------------------------
# Optional. When these are absent, payments are OFF: orders are created with
# payment_status='pending' and the customer is told plainly that payment has
# not been collected. No payment is ever reported as successful without a
# server-verified signature (brief §64).
#
# RAZORPAY_KEY_SECRET signs and verifies payments — treat it like a password.
# RAZORPAY_WEBHOOK_SECRET is set when you create the webhook in the Razorpay
# dashboard; it is what proves an incoming webhook really came from Razorpay.

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
